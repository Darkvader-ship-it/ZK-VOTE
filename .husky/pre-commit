#!/bin/sh

echo "Running pre-commit checks..."

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

# Format Rust code — only when Rust sources are staged, and only when the
# toolchain is available. Previously this ran on every commit and aborted
# (exit 1) even when cargo was simply not installed, blocking unrelated
# e.g. backend-only commits with "Rust code not formatted".
if echo "$STAGED" | grep -qE '\.rs$|(^|/)Cargo\.(toml|lock)$'; then
    if command -v cargo >/dev/null 2>&1; then
        echo "→ Checking Rust formatting..."
        if ! cargo fmt --check; then
            echo "ERROR: Rust code not formatted. Run 'cargo fmt' first."
            exit 1
        fi
        echo "✓ Rust formatting OK"

        # Run Rust clippy (warnings only, don't block)
        echo "→ Running Rust clippy..."
        cargo clippy --workspace --quiet || true
    else
        echo "→ Skipping Rust checks (cargo not installed)"
    fi
else
    echo "→ Skipping Rust checks (no Rust files staged)"
fi

# Lint frontend if changes in frontend/
if echo "$STAGED" | grep -q "^frontend/"; then
    echo "→ Linting frontend..."
    cd frontend && npm run lint --silent || {
        echo "ERROR: Frontend lint failed. Run 'cd frontend && npm run lint' to see errors."
        exit 1
    }
    cd ..
    echo "✓ Frontend lint OK"
fi

# Lint backend if changes in backend/ and lint script exists.
# The repo-wide `npm run lint` (eslint . && tsc --noEmit) type-checks EVERY
# backend file, so it fails on unrelated sources and cannot verify this
# commit. Pre-commit must gate what is actually being committed, so lint
# exactly the staged backend files instead.
if echo "$STAGED" | grep -q "^backend/"; then
    if grep -q '"lint"' backend/package.json 2>/dev/null; then
        echo "→ Linting backend staged files..."
        cd backend
        FAILED=0
        for file in $(echo "$STAGED" | grep '^backend/.*\.ts$' | sed 's|^backend/||'); do
