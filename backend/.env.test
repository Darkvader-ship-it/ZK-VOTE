# Test Environment Profile
NODE_ENV=test
RELAYER_TEST_MODE=true

# Server
PORT=3001

# Soroban RPC (Testnet)
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Authentication
# Must be at least 32 chars in length to pass validation, unless testMode bypasses it
RELAYER_AUTH_TOKEN=ci-test-token-placeholder-32-chars-min
# This key is allowed by config.ts specifically for tests
RELAYER_SECRET_KEY=SCZANGBA5AKIA7VTJQXBDKPQOBFZD3NWKNR3CQULPSFMJUADSHWFUCS

# Contract IDs (Placeholders)
VOTING_CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
TREE_CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC
COMMENTS_CONTRACT_ID=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC

# Logging (Minimal for tests)
LOG_CLIENT_IP=hash
LOG_REQUEST_BODY=false
STRIP_REQUEST_BODIES=true
RELAYER_GENERIC_ERRORS=true

# Rate Limits (Relaxed for tests)
COMMITMENT_RATE_LIMIT=1000
COMMITMENT_RATE_WINDOW_MS=60000
