# Development Environment Profile
NODE_ENV=development

# Server
PORT=3001

# Soroban RPC (Local)
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
NETWORK_PASSPHRASE="Standalone Network ; February 2017"

# Authentication (Placeholders)
RELAYER_AUTH_TOKEN=dev_auth_token_placeholder_for_local_development_only
RELAYER_SECRET_KEY=S_PLACEHOLDER_DEV_SECRET_KEY_NOT_VALID_FOR_REAL_TRANSACTION

# Contract IDs (Placeholders)
VOTING_CONTRACT_ID=C_PLACEHOLDER_VOTING_CONTRACT_ID_DEV_000000000000000000
TREE_CONTRACT_ID=C_PLACEHOLDER_TREE_CONTRACT_ID_DEV_00000000000000000000
COMMENTS_CONTRACT_ID=C_PLACEHOLDER_COMMENTS_CONTRACT_ID_DEV_0000000000000000
DAO_REGISTRY_CONTRACT_ID=C_PLACEHOLDER_DAO_REGISTRY_CONTRACT_ID_DEV_000000000000
MEMBERSHIP_SBT_CONTRACT_ID=C_PLACEHOLDER_MEMBERSHIP_SBT_CONTRACT_ID_DEV_0000000000
BRIDGE_CONTRACT_ID=C_PLACEHOLDER_BRIDGE_CONTRACT_ID_DEV_000000000000000000
CIRCUIT_REGISTRY_CONTRACT_ID=C_PLACEHOLDER_CIRCUIT_REGISTRY_CONTRACT_ID_DEV_00000000

# Logging (Verbose for Dev)
LOG_CLIENT_IP=plain
LOG_REQUEST_BODY=true
STRIP_REQUEST_BODIES=false
RELAYER_GENERIC_ERRORS=false

# Rate Limits (Relaxed for Dev)
COMMITMENT_RATE_LIMIT=100
COMMITMENT_RATE_WINDOW_MS=60000
